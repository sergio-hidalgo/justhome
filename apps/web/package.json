{
  "name": "@vivienda/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "node --env-file-if-exists=.env src/check-env.ts && astro dev --port 4321",
    "start": "node --env-file-if-exists=.env src/check-env.ts && node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/preact": "^6.0.6",
    "astro": "^7.3.8",
    "preact": "^10.29.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "typescript": "^6.0.3"
  }
}
